# Map jk = esc
hook global InsertChar k %{
  try %{
    exec -draft hH <a-k>jk<ret> d
    exec -with-hooks <esc>
  }
}

# Enter command prompt with ö
map global normal ö :

# Easy paragraph selection
map global normal ä ]p
map global normal Ä }p
map global normal <a-ä> <a-]>p
map global normal <a-Ä> <a-}>p
map global normal ü [p
map global normal Ü {p
map global normal <a-ü> <a-[>p
map global normal <a-Ü> <a-{>p

# Swap / and ? (search) with - and _, like on a US keyboard
# (No need to restore <minus> since that seems to be a NOP anyway.)
map global normal <minus> /
map global normal <a-minus> <a-/>
map global normal _ ?
map global normal <a-_> <a-?>
map global normal ß _
map global normal <a-ß> <a-_>

# Tab display width and indent
set-option global tabstop 2
set-option global indentwidth 2

# Window splitting, horizontal
define-command split \
  -docstring "open file in horizontal tmux split" \
  -params .. %{
    tmux-terminal-vertical kak -c %val{session} %arg{@}
  }
complete-command split file
alias global hsplit split

# Window splitting, vertical
define-command vsplit \
  -docstring "open file in vertical tmux split" \
  -params .. %{
    tmux-terminal-horizontal kak -c %val{session} %arg{@}
  }
complete-command vsplit file
alias global new vsplit

# Close all windows
define-command quit-all %{
  evaluate-commands -client * quit
}

# Tab completion
hook global InsertCompletionShow .* %{
  map window insert <tab> <c-n>
  map window insert <s-tab> <c-p>
}
hook global InsertCompletionHide .* %{
  unmap window insert <tab> <c-n>
  unmap window insert <s-tab> <c-p>
}

# Language Server setup
eval %sh{kak-lsp}
set-option global modelinefmt "%opt{lsp_modeline} %opt{modelinefmt}"
map global user l ':enter-user-mode lsp<ret>' -docstring 'LSP mode'
map global goto d <esc>:lsp-definition<ret> -docstring 'LSP definition'
map global goto r <esc>:lsp-references<ret> -docstring 'LSP references'
map global goto y <esc>:lsp-type-definition<ret> -docstring 'LSP type definition'
map global insert <tab> '<a-;>:try lsp-snippets-select-next-placeholders catch %{ execute-keys -with-hooks <lt>tab> }<ret>' -docstring 'Select next snippet placeholder'
map global object a '<a-semicolon>lsp-object<ret>' -docstring 'LSP any symbol'
map global object <a-a> '<a-semicolon>lsp-object<ret>' -docstring 'LSP any symbol'
map global object f '<a-semicolon>lsp-object Function Method<ret>' -docstring 'LSP function or method'
map global object t '<a-semicolon>lsp-object Class Interface Module Namespace Struct<ret>' -docstring 'LSP class or module'
map global object d '<a-semicolon>lsp-diagnostic-object error warning<ret>' -docstring 'LSP errors and warnings'
map global object D '<a-semicolon>lsp-diagnostic-object error<ret>' -docstring 'LSP errors'

# Filetype specifics
hook global WinSetOption filetype=haskell %{
  lsp-enable-window
  alias window format lsp-formatting
}
hook global WinSetOption filetype=java %{
  lsp-enable-window
  alias window format lsp-formatting
}
hook global WinSetOption filetype=json %{
  set-option window formatcmd 'jq .'
}
hook global WinSetOption filetype=markdown %{
  set-option window formatcmd 'mdformat --wrap 80 --number -'
}
hook global WinSetOption filetype=python %{
  lsp-enable-window
  alias window format lsp-formatting
}
hook global WinSetOption filetype=xml %{
  # Register Lemminx because kakoune-lsp doesn't know about it
  set-option window lsp_servers %{
    [lemminx]
    root_globs = [".git", ".hg"]
    settings_section = "_"
    [lemminx.settings._]
    xml.format.maxLineWidth = 0
  }
  lsp-enable-window
  alias window format lsp-formatting
  # set-option window formatcmd 'xmllint --format -'
}

# Disable Clippy
set-option -add global ui_options terminal_assistant=none
